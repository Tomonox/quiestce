{
  "name": "brainrot-qui-est-ce",
  "version": "1.0.0",
  "type": "module",
  "description": "Jeu multijoueur en ligne Qui est-ce ? sur les Brainrots de Roblox (Steal a Brainrot)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "postinstall": "npm --prefix client install",
    "fetch-brainrots": "node server/scripts/fetchBrainrots.js",
    "install-all": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["qui-est-ce", "guess-who", "brainrot", "roblox", "multiplayer", "socket.io"],
  "author": "",
  "license": "MIT"
}
